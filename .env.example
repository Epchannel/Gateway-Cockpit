# This file is documentation only; the application does not load .env automatically.
# Configure these non-secret variables in the service/user environment.
# Production secrets are read only from API_HNQ_SECRETS_FILE outside this repository.
# API_HNQ_SECRETS_FILE=C:\Users\<user>\AppData\Local\ApiHnq\secrets.json
API_HNQ_HOST=127.0.0.1
API_HNQ_PORT=8787
API_HNQ_DATABASE_PATH=./data/api-hnq.sqlite
API_HNQ_PUBLIC_ORIGIN=https://apihnq.hnquan.com
API_HNQ_UPSTREAM_URL=http://127.0.0.1:65238/v1
# Maximum JSON request size for POST /v1/chat/completions and /v1/responses.
# Admin/login and all other routes remain capped at 1048576 bytes.
API_HNQ_BODY_LIMIT=16777216
API_HNQ_DEFAULT_RPM=60
API_HNQ_DEFAULT_CONCURRENCY=4
API_HNQ_UPSTREAM_CONNECT_TIMEOUT_MS=10000
API_HNQ_UPSTREAM_HEADER_TIMEOUT_MS=30000
API_HNQ_UPSTREAM_IDLE_TIMEOUT_MS=30000
API_HNQ_UPSTREAM_TOTAL_TIMEOUT_MS=120000
API_HNQ_MAX_UPSTREAM_RESPONSE_BYTES=8388608
