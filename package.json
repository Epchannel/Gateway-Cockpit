{
  "name": "api-hnq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "vite build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.admin.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,html,md}\"",
    "test": "vitest run --config vitest.config.ts",
    "admin:bootstrap": "tsx src/cli.ts bootstrap-admin",
    "db:backup": "tsx src/cli.ts backup",
    "db:restore": "tsx src/cli.ts restore"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
